# Reference only: set environment variables in the shell before running.
# server.js does not automatically load a .env file.
# Safe default: local-only demo on port 3000. No Twitch credentials required.
PORT=3000
HOST=127.0.0.1

# Public read-only chat: set your channel login (e.g. enriedit) and opt in with 1.
# No OAuth credentials required. Reads public chat; never sends messages.
# Leave channel empty and anonymous 0 for the credential-free local simulation.
TWITCH_CHANNEL=
TWITCH_ANONYMOUS=0

# Authenticated alternative: anonymous must be 0, token needs chat:read.
# Never publish/commit your token. Bot login must match the token owner.
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=

# Optional browser OAuth: public client ID of a Confidential Twitch application.
# Set TWITCH_CHANNEL, start server, then open http://localhost:3000/auth/twitch.
# Register exact redirect http://localhost:3000/auth/callback (match PORT).
# No bot/token env vars needed for this flow; authorized token stays in memory.
TWITCH_CLIENT_ID=

# Required when HOST=0.0.0.0 / deploying publicly, protects streamer controls.
CONTROL_KEY=
